<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  
  <connectionStrings>
    <!-- عدّل هذه الإعدادات حسب بيئتك -->
    <!-- مصادقة Windows (موصى به) -->
<add name="POSSystem" 
         connectionString="Server=.;Database=POSSystem;Integrated Security=True;Connection Timeout=30;TrustServerCertificate=true;Encrypt=false;"
         providerName="System.Data.SqlClient"/>
    
    <!-- مصادقة SQL Server (قم بتفعيل هذا السطر إذا لزم الأمر وتعطيل السطر أعلاه)
    <add name="POSSystem" 
         connectionString="Server=localhost;Database=POSSystem;User Id=sa;Password=YourPassword123;Connection Timeout=30;"
         providerName="System.Data.SqlClient"/>
    -->
  </connectionStrings>
  
  <appSettings>
    <add key="AppVersion" value="2.0"/>
    <add key="AppName" value="نظام إدارة المبيعات والمخازن"/>
    <add key="DefaultWarehouseID" value="1"/>
    <add key="PrinterName" value=""/>
    <add key="ReceiptWidth" value="80"/>
  </appSettings>
</configuration>
