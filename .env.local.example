# MongoDB Atlas Connection String
# Go to: https://cloud.mongodb.com → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sci_pos?retryWrites=true&w=majority

# JWT Secret - use any long random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# App URL (change in production)
NEXTAUTH_URL=http://localhost:3000

# Default Admin Credentials (first run only)
ADMIN_EMAIL=admin@sci.sd
ADMIN_PASSWORD=Admin@123
